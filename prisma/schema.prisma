generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  functionId   String?
  function     OrgFunction? @relation(fields: [functionId], references: [id])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

/// Função organizacional (cargo ministerial / área de atuação)
model OrgFunction {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FeedPost {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String?
  series      String?
  speaker     String?
  publishedAt DateTime @default(now())
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChurchEvent {
  id          String          @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  location    String          @default("Paz Church Metrópole - Ananindeua")
  recurring   String?
  isPast      Boolean         @default(false)
  locationId  String?
  churchLoc   ChurchLocation? @relation(fields: [locationId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model MenuLink {
  id        String   @id @default(cuid())
  section   String
  label     String
  path      String?
  external  String?
  icon      String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
}

model ChurchLocation {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  kind        String      @default("regional")
  address     String
  city        String
  state       String      @default("PA")
  cep         String?
  schedule    String?
  sortOrder   Int         @default(0)
  active      Boolean     @default(true)
  lifeGroups  LifeGroup[]
  events      ChurchEvent[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Sermon {
  id          String   @id @default(cuid())
  title       String
  category    String   @default("Cultos")
  speaker     String?
  summary     String?
  imageUrl    String?
  publishedAt DateTime @default(now())
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LifeGroup {
  id            String            @id @default(cuid())
  name          String
  leaderName    String
  leaderPhone   String?
  leaderEmail   String?
  address       String
  neighborhood  String
  city          String            @default("Ananindeua")
  dayOfWeek     String
  meetingTime   String
  ageGroup      String            @default("adultos")
  capacity      Int               @default(12)
  active        Boolean           @default(true)
  locationId    String?
  location      ChurchLocation?   @relation(fields: [locationId], references: [id])
  signups       LifeGroupSignup[]
  reports       LifeGroupReport[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model LifeGroupSignup {
  id           String     @id @default(cuid())
  fullName     String
  email        String
  phone        String
  city         String
  neighborhood String?
  ageGroup     String
  message      String?
  status       String     @default("pending")
  lifeGroupId  String?
  lifeGroup    LifeGroup? @relation(fields: [lifeGroupId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model LifeGroupReport {
  id          String    @id @default(cuid())
  lifeGroupId String
  lifeGroup   LifeGroup @relation(fields: [lifeGroupId], references: [id], onDelete: Cascade)
  weekDate    DateTime
  attendance  Int       @default(0)
  visitors    Int       @default(0)
  notes       String?
  testimony   String?
  authorName  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Ministry {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  active      Boolean           @default(true)
  sortOrder   Int               @default(0)
  volunteers  VolunteerSignup[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model VolunteerSignup {
  id         String    @id @default(cuid())
  fullName   String
  email      String
  phone      String
  ministryId String?
  ministry   Ministry? @relation(fields: [ministryId], references: [id])
  ministryLabel String?
  message    String?
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}
